# Copy the required values into your deployment's secret manager.
# Do not commit real credentials to source control.
PORT=3000
NODE_ENV=production
SITE_URL=https://family-soft.ru
SESSION_SECRET=
ADMIN_PASSWORD=
ADMIN_IP_ALLOWLIST=

# Payment mode: manual or yookassa. All credentials stay on the server.
PAYMENT_MODE=manual
SBP_PHONE=
SBP_BANK=
SBP_RECEIVER_NAME=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
RECEIPT_MODE=none
RECEIPT_TAX_SYSTEM_CODE=
RECEIPT_VAT_CODE=1

# Optional mail delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# MAX bots: MAX_BOT_TOKEN is the existing Fami sender (legacy installs also use it as the only bot).
MAX_BOT_TOKEN=
MAX_BOT_OWNER_ID=
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
# Optional separate buyer bot (Helpie). When set, it receives buyer chat updates;
# the Worker uses MAX_BOT_TOKEN only for Fami payment notifications.
BUYER_BOT_TOKEN=
BUYER_WEBHOOK_SECRET=

# Optional integrations are not enabled in this initial release.
BACKUP_KEY=
